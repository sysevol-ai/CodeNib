<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Install and Sign in ask Terminal, through osascript, to run the
       agent's own command. The hardened runtime that notarization requires
       refuses Apple events without this entitlement. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>

[flake8]
select = B,C,E,F,P,T4,W,B9
max-line-length = 88
# Keep E203/W503 ignored to match Black; allow import-star patterns in tooling.
ignore =
    E127, E128, E203, E265, E266, E402,
    E501, E722, P207, P208, W503, C901,
    F403, F405, E704, F541
exclude =
    .git,
    .hg,
    __pycache__,
    .venv,
    venv,
    env,
    .mypy_cache,
    .pytest_cache,
    .tox,
    .eggs,
    *.egg-info,
    build,
    dist,
    third_party,
    docs/_build

max-complexity = 12

# The deterministic SVG renderer contains literal XML attribute quoting and
# intentionally long markup lines; these two Bugbear style checks do not map
# cleanly to generated XML templates. The site's figure and replay renderers
# write HTML/SVG attributes the same way.
per-file-ignores =
    codenib/wiki/media_generation.py:B907,B950
    scripts/blog_figure_theme.py:B907
    scripts/render_agent_replay.py:B907
    test/test_blog_figure_theme.py:B907

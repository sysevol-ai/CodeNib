{
  "schema_version": 1,
  "bundle": {
    "name": "CodeMiner paper artifact (core)",
    "version": "core-rc28"
  },
  "sources": [
    {
      "id": "artifact-readme",
      "root": "code",
      "path": "artifact/README.md",
      "destination": "README.md"
    },
    {
      "id": "artifact-eval-entrypoint",
      "root": "code",
      "path": "artifact/artifact_eval.py",
      "destination": "artifact_eval.py"
    },
    {
      "id": "artifact-runner",
      "root": "code",
      "path": "artifact/run.sh",
      "destination": "run.sh"
    },
    {
      "id": "artifact-container",
      "root": "code",
      "path": "artifact/Dockerfile",
      "destination": "Dockerfile"
    },
    {
      "id": "artifact-dockerignore",
      "root": "code",
      "path": "artifact/.dockerignore",
      "destination": ".dockerignore"
    },
    {
      "id": "license-boundaries",
      "root": "code",
      "path": "artifact/LICENSES.md",
      "destination": "LICENSES.md"
    },
    {
      "id": "code-license",
      "root": "code",
      "path": "LICENSE",
      "destination": "LICENSE-CODE"
    },
    {
      "id": "figure-config",
      "root": "code",
      "path": "artifact/paper_artifact_config.json",
      "destination": "paper_artifact_config.json"
    },
    {
      "id": "dense-model-scale",
      "root": "code",
      "path": "artifact/dense-model-scale.json",
      "destination": "inputs/dense-model-scale.json"
    },
    {
      "id": "incremental-maintenance-results",
      "root": "code",
      "path": "docs/experiments/artifacts/incremental_maintenance_v1",
      "destination": "inputs/incremental_maintenance_v1"
    },
    {
      "id": "codeminer-runtime",
      "root": "code",
      "path": "codeminer",
      "destination": "runtime/codeminer",
      "exclude": [
        "*.pyc"
      ],
      "exclude_dir_names": [
        "__pycache__"
      ]
    },
    {
      "id": "incremental-runners",
      "root": "code",
      "path": "scripts/profiling",
      "destination": "runtime/scripts/profiling",
      "include": [
        "aggregate_incremental_maintenance.py",
        "profile_graph_rebuild_stability.py",
        "profile_incremental_graph.py",
        "profile_incremental_vector.py"
      ],
      "exclude_dir_names": [
        "__pycache__"
      ]
    },
    {
      "id": "incremental-tests",
      "root": "code",
      "path": "test",
      "destination": "runtime/test",
      "include": [
        "agent/test_lsp_graph.py",
        "eval/test_lsp_replay_benchmark.py",
        "eval/test_maintenance_manifest.py",
        "eval/test_paper_artifact_eval.py",
        "graph/incremental/*.py",
        "index/incremental/*.py",
        "scip/test_scip_go.py",
        "scripts/test_aggregate_incremental_maintenance.py",
        "scripts/test_profile_graph_rebuild_stability.py",
        "scripts/test_profile_incremental_graph.py",
        "scripts/test_profile_incremental_vector.py"
      ],
      "exclude": [
        "*.pyc"
      ],
      "exclude_dir_names": [
        "__pycache__"
      ]
    },
    {
      "id": "runtime-build-metadata",
      "root": "code",
      "path": "pyproject.toml",
      "destination": "runtime/pyproject.toml"
    },
    {
      "id": "runtime-readme",
      "root": "code",
      "path": "README.md",
      "destination": "runtime/README.md"
    },
    {
      "id": "agent-runtime-protocols",
      "root": "code",
      "path": "scripts/agent_compile",
      "destination": "protocol/agent_runtime",
      "include": [
        "configs/design_space.yaml",
        "configs/qwen_base_compact.yaml",
        "configs/qwen35_9b_synth_runtime.yaml",
        "configs/qwen35_27b_synth_runtime.yaml",
        "configs/gemma4_12b_synth_runtime.yaml",
        "configs/gemini25_flash_synth_runtime.yaml",
        "run_synthesis_sweep.py"
      ],
      "exclude_dir_names": [
        "__pycache__"
      ]
    },
    {
      "id": "base-dataset",
      "root": "base_dataset",
      "path": "data/test-00000-of-00001.parquet",
      "destination": "inputs/datasets/base/test-00000-of-00001.parquet"
    },
    {
      "id": "synthesis-dataset",
      "root": "synthesis_dataset",
      "path": ".",
      "destination": "inputs/datasets/synthesis",
      "include": [
        ".gitattributes",
        "README.md",
        "quality_report.json",
        "C++_C/test-00000-of-00001.parquet",
        "Go/test-00000-of-00001.parquet",
        "Python/test-00000-of-00001.parquet",
        "Rust/test-00000-of-00001.parquet",
        "TypeScript_JavaScript/test-00000-of-00001.parquet"
      ],
      "exclude_dir_names": [
        ".cache"
      ]
    },
    {
      "id": "dataset-stats",
      "root": "data",
      "path": "dataset_stats.json",
      "destination": "inputs/dataset_stats.json"
    },
    {
      "id": "profile-records",
      "root": "data",
      "path": "profile_log",
      "destination": "inputs/profile_log",
      "exclude": [
        "*.pyc"
      ],
      "exclude_dir_names": [
        ".git",
        "__pycache__"
      ]
    },
    {
      "id": "retrieval-evaluation",
      "root": "data",
      "path": "eval_results",
      "destination": "inputs/eval_results",
      "exclude": [
        "*.pyc"
      ],
      "exclude_dir_names": [
        ".git",
        "__pycache__"
      ]
    },
    {
      "id": "dense-graphrag-matrix",
      "root": "data",
      "path": "results/dense_graphrag_matrix_v4",
      "destination": "inputs/dense_graphrag_matrix_v4",
      "exclude": [
        "*.pyc"
      ],
      "exclude_dir_names": [
        ".git",
        "__pycache__"
      ]
    },
    {
      "id": "dense-graphrag-development-sweep",
      "root": "data",
      "path": "results/dense_graphrag_dev_reference_rrf_sweep_v2.json",
      "destination": "inputs/dense_graphrag_dev_reference_rrf_sweep_v2.json"
    },
    {
      "id": "faiss-index-family",
      "root": "data",
      "path": "results/faiss_index_family_qwen06_100.json",
      "destination": "inputs/faiss_index_family_qwen06_100.json"

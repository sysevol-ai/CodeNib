      "destination": "inputs/lsp_agent_base_haiku_confirmatory_v2_analysis.json"
    },
    {
      "id": "materialized-trace",
      "root": "data",
      "path": "results/materialized_trace_batch_v9",
      "destination": "inputs/materialized_trace_batch_v9",
      "exclude": [
        "SHA256SUMS",
        "*.pyc"
      ],
      "exclude_dir_names": [
        ".git",
        "__pycache__",
        "cache"
      ]
    },
    {
      "id": "snapshot-amortization",
      "root": "data",
      "path": "results/snapshot_amortization_qwen06_synth.json",
      "destination": "inputs/snapshot_amortization_qwen06_synth.json"
    },
    {
      "id": "agent-sensitivity",

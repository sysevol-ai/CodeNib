      ]
    },
    {
      "id": "agent-qwen-9b",
      "root": "data",
      "path": "results/qwen35_9b_synth_runtime_v1",
      "destination": "inputs/agent/qwen35_9b_synth_runtime_v1",
      "exclude": [

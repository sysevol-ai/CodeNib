    "codex-mcp.py": "import importlib.metadata\nimport json\nimport os\nimport time\nfrom pathlib import Path\nfrom openai_codex import Codex, CodexConfig, ApprovalMode, Sandbox\nfrom openai_codex.generated.v2_all import ReasoningEffort\n\nROOT=Path('/tmp/codenib-sdk-probe-20261027')\nfor name in ('OPENAI_API_KEY','CODEX_API_KEY','ANTHROPIC_API_KEY'):\n    os.environ.pop(name,None)\nserver={'command':'/home/zhongming/.venvs/codenib/bin/python','args':['-m','codenib','mcp',str(ROOT/'repository'),'--tool-surface','full'],'env':{'CODENIB_HOME':str(ROOT/'state'),'PYTHONPATH':'/home/zhongming/CodeNib-codegraph-benefit'},'enabled_tools':['dependency_subgraph']}\n# All values are TOML-safe quoted strings or JSON-compatible scalar arrays.\nserver_toml='{command='+json.dumps(server['command'])+',args='+json.dumps(server['args'])+',env={'+','.join(k+'='+json.dumps(v) for k,v in server['env'].items())+'},enabled_tools=[\"dependency_subgraph\"]}'\nconfig=CodexConfig(codex_bin='/home/zhongming/.local/bin/codex',cwd=str(ROOT),config_overrides=('features.apps=false','features.plugins=false','features.multi_agent=false','web_search=\"disabled\"','mcp_servers.codenib='+server_toml))\nstarted=time.monotonic()\nwith Codex(config) as client:\n    account=client.account().account\n    principal=getattr(account,'root',account)\n    auth={'sdk':importlib.metadata.version('openai-codex'),'account_type':getattr(principal,'type',None),'api_key_env_supplied':False}\n    (ROOT/'codex-account.json').write_text(json.dumps(auth,indent=2))\n    print('auth',json.dumps(auth),flush=True)\n    thread=client.thread_start(cwd=str(ROOT),sandbox=Sandbox.read_only,approval_mode=ApprovalMode.auto_review,ephemeral=True)\n    result=thread.run('Connectivity check only: call the codenib dependency_subgraph MCP tool for sdk_probe_checkout with direction dependencies and depth 1. Do not run shell commands or edit any files. Reply with the callee name only.',effort=ReasoningEffort.low)\n    calls=[]\n    for item in result.items:\n        data=item.model_dump(mode='json')\n        if data.get('type')=='mcpToolCall':\n            calls.append(data)\n    receipt={**auth,'status':str(result.status),'error':result.error.model_dump(mode='json') if result.error else None,'elapsed_seconds':round(time.monotonic()-started,3),'final_response':result.final_response,'usage':result.usage.model_dump(mode='json') if result.usage else None,'mcp_calls':calls,'api_invoice_cost_usd':None,'scope':'Forced MCP connectivity smoke, not a matched-benefit or adoption task.'}\n    (ROOT/'codex-mcp.json').write_text(json.dumps(receipt,indent=2))\n    print(json.dumps({k:receipt[k] for k in ('status','elapsed_seconds','final_response','usage')}),flush=True)\n    print('MCP calls',len(calls),flush=True)\n    assert calls, 'No captured MCP tool call; inspect SDK receipt instead of claiming success'\n    assert 'sdk_probe_calculate' in (result.final_response or ''),receipt\n",
    "claude-mcp.py": "import asyncio\nimport dataclasses\nimport importlib.metadata\nimport json\nimport os\nimport time\nfrom pathlib import Path\nfrom claude_agent_sdk import query, ClaudeAgentOptions\n\nROOT=Path('/tmp/codenib-sdk-probe-20261027')\nfor name in ('ANTHROPIC_API_KEY','ANTHROPIC_AUTH_TOKEN','ANTHROPIC_BASE_URL','CLAUDE_CODE_USE_BEDROCK','CLAUDE_CODE_USE_VERTEX','CLAUDE_CODE_USE_FOUNDRY'):\n    os.environ.pop(name,None)\nserver={'command':'/home/zhongming/.venvs/codenib/bin/python','args':['-m','codenib','mcp',str(ROOT/'repository'),'--tool-surface','full'],'env':{'CODENIB_HOME':str(ROOT/'state'),'PYTHONPATH':'/home/zhongming/CodeNib-codegraph-benefit'}}\nasync def main():\n    start=time.monotonic()\n    calls=[]\n    final=None\n    init={}\n    opts=ClaudeAgentOptions(cwd=str(ROOT),cli_path='/home/zhongming/.local/bin/claude',setting_sources=[],strict_mcp_config=True,mcp_servers={'codenib':server},allowed_tools=['mcp__codenib__dependency_subgraph'],tools=[],plugins=[],max_turns=3,max_budget_usd=1.0)\n    async for message in query(prompt='Connectivity check only: call the codenib dependency_subgraph MCP tool for sdk_probe_checkout with direction dependencies and depth 1. Do not run shell commands or edit any files. Reply with the callee name only.',options=opts):\n        if type(message).__name__=='SystemMessage' and getattr(message,'subtype',None)=='init':\n            data=message.data\n            init={k:data.get(k) for k in ('model','apiKeySource','mcp_servers','tools','permissionMode','claude_code_version')}\n        for block in getattr(message,'content',[]):\n            if type(block).__name__=='ToolUseBlock':\n                calls.append(dataclasses.asdict(block))\n        if type(message).__name__=='ResultMessage':\n            final={k:getattr(message,k,None) for k in ('subtype','is_error','duration_ms','num_turns','total_cost_usd','usage','result')}\n    receipt={'sdk':importlib.metadata.version('claude-agent-sdk'),'api_key_env_supplied':False,'credential_route':'existing Claude Code claude.ai/Max login; no credential values read or copied','elapsed_seconds':round(time.monotonic()-start,3),'init':init,'result':final,'tool_calls':calls,'api_invoice_cost_usd':None,'scope':'Forced MCP connectivity smoke, not a matched-benefit or adoption task.'}\n    (ROOT/'claude-mcp.json').write_text(json.dumps(receipt,indent=2))\n    print(json.dumps(receipt,indent=2))\n    assert final and not final.get('is_error'),receipt\n    assert any(c.get('name')=='mcp__codenib__dependency_subgraph' for c in calls),receipt\n    assert 'sdk_probe_calculate' in (final.get('result') or ''),receipt\nasyncio.run(asyncio.wait_for(main(),timeout=90))\n"
